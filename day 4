positive,negative 

#include <stdio.h>

int main() {
    int i;
    printf("enter i value : ");
    scanf("%d",&i);
    if(i>0){
        printf("positive");
    }
    else if(i==0){
        printf("zero");
    }
    else{
        printf("negative");
    }

    return 0;
}


