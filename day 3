profit and loss


#include <stdio.h>

int main() {
    float cp,sp;
    printf("enter the cp :");
    scanf("%f",&cp);
    printf("enter the sp :");
    scanf("%f",&sp);
    if(sp>cp){
        printf("profit = %0.3f ",sp-cp);
    }
    else if(cp>sp){
        printf("loss = %0.3f",cp-sp);
    }
    else{
        printf("invested amount is taken = %0.3f",cp);
    }
    return 0;
}



