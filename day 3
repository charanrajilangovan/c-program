largest of two numbers




#include <stdio.h>

int main() {
    float A,B;
    printf("enter the 1st number : ");
    scanf("%f",&A);
    printf("enter the 2nd number : ");
    scanf("%f",&B);
    if(A>B){
        printf(" A is greter because it is %f which is %.2f more greater then B ",A,A-B);
    }
    else{
        printf(" B is greater because it is %f which is %.2f more greater then A ",B,B-A);
    }
    return 0;
}



